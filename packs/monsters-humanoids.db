{"_id":"k2GVOoU8kHVIYqMb","name":"Apprentice Assassin","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:apprentice-assassin","level":3,"monsterType":"Humanoid","intelligence":"Average","perception":"Five Senses","disposition":"Neutral","soulscars":0,"languages":"Trade Common, Regional Dialect, Learned Magic Language","habitat":"Various","reputation":6,"weakness":0,"weakPoint":"None","initiative":11,"movementSpeed":"15/-","fortitude":"5 (12)","willpower":"4 (11)","source":"GR, Battle Mastery p. 152","description":"A young person who has just started taking on assassination work. They have little experience in actual combat, and try their best to eliminate enemies outside of combat.","combatStyles":[{"style":"Weapon","accuracy":"4 (11)","damage":"2d+2","evasion":"4 (11)","defense":2,"hp":{"value":19,"max":19},"mp":{"value":9,"max":9}}],"uniqueSkills":[{"title":"◯ Sword's Grace/Change Fate","description":"Once per day, they may choose to change the result of a Skill Check or Damage roll, by switching the faces of the rolled 2d to the opposite sides."},{"title":"🗨 Desperate Strike I","description":"Add +5 damage to a successful Weapon attack. At the same time, the Apprentice Assassin receives 5 points of fixed damage to HP.\nIf the attack is not successful, the Assassin does not receive any fixed damage."}],"lootTable":[{"roll":"2 - 6","loot":"Nothing"},{"roll":"7 - 9","loot":"Bag of Silver (50G/-)"},{"roll":"10+","loot":"Gem (150G/Gold A)"}]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Apprentice Assassin","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"attribute":"mp"},"light":{"negative":false,"priority":0,"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}},"sight":{"enabled":false,"range":0,"angle":360,"visionMode":"basic","color":null,"attenuation":0.1,"brightness":0,"saturation":0,"contrast":0},"detectionModes":{},"occludable":{"radius":0},"ring":{"enabled":false,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":null}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"flags":{},"randomImg":false,"appendNumber":false,"prependAdjective":false},"items":[],"effects":[],"sort":0}
{"_id":"kow5tDpmefxz4rdj","name":"Dual-Wielding Battle Dancer","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:dual-wielding-battle-dancer","level":7,"monsterType":"Humanoid","intelligence":"Average","perception":"Five senses","disposition":"Neutral","soulscars":0,"languages":"Trade Common, Regional Dialect","habitat":"Various","reputation":10,"weakness":0,"weakPoint":"None","initiative":16,"movementSpeed":"20","fortitude":"10 (17)","willpower":"9 (16)","source":"Natural History of Dorden p. 133","description":"The Dual-Wielding Battle Dancer fights by applying their dancing movements to their combat movements. They are quite skilled in one-on-one battles, but are not good at fighting multiple opponents.","combatStyles":[{"style":"Weapon","accuracy":"9 (16)","damage":"2d+9","evasion":"10 (17)","defense":3,"hp":{"value":47,"max":47},"mp":{"value":15,"max":15}}],"uniqueSkills":[{"title":"◯Twin Strike &amp; Double Attack","description":"They can make two Weapon attacks each round. After checking the result of the first attack, the monster can choose whether to make a second attack on the same target further or on a different target of their choice."},{"title":"◯Killing Blow","description":"If the 2d roll determining damage is 9 or more, the damage is increased by +5 points."},{"title":"◯Flowing Water Stance / 10 (17)","description":"When they are about to be caught in the effects of &quot;Area: Shot &quot; targeting &quot;1 Character&quot;, or effects of &quot;Area: Line &quot; or &quot;Area: Breakthrough &quot;, they can attempt to evade or resist using this ability's Success Value instead of the original Evasion or resistance check. If the check results in a favorable outcome, it is treated as if they succeeded in the substituted check."},{"title":"◯Sword's Grace/Change Fate","description":"Once per day, they may choose to change the result of a Skill Check or Damage roll by switching the faces of the rolled 2d to the opposite sides and adding +1 to it."}],"lootTable":[{"roll":"2 - 7","loot":"Gem (150G / Gold A)"},{"roll":"8+","loot":"Gem (150G / Gold A) x 1d"}]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Dual-Wielding Battle Dancer","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"attribute":"mp"},"light":{"negative":false,"priority":0,"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}},"sight":{"enabled":false,"range":0,"angle":360,"visionMode":"basic","color":null,"attenuation":0.1,"brightness":0,"saturation":0,"contrast":0},"detectionModes":{},"occludable":{"radius":0},"ring":{"enabled":false,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":null}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"flags":{},"randomImg":false,"appendNumber":false,"prependAdjective":false},"items":[],"effects":[],"sort":0}
{"_id":"lVndbseNDBlrC1k3","name":"Evil Knight","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:evil-knight","level":5,"monsterType":"Humanoid","intelligence":"Average","perception":"Five Senses","disposition":"Neutral","soulscars":0,"languages":"Trade Common, Regional Dialect","habitat":"Various","reputation":8,"weakness":0,"weakPoint":"None","initiative":12,"movementSpeed":"13/-","fortitude":"7 (14)","willpower":"8 (15)","source":"GR, Battle Mastery p. 153","description":"A knight clad in metal armor who uses their strength not to protect a country or people, but for evil. They are highly durable and well prepared to guard against magic, so when challenged head-on, can be a difficult opponent to deal with.","combatStyles":[{"style":"Weapon","accuracy":"7 (14)","damage":"2d+7","evasion":"7 (14)","defense":7,"hp":{"value":44,"max":44},"mp":{"value":18,"max":18}}],"uniqueSkills":[{"title":"◯ Sword's Grace/Change Fate","description":"Once per day, they may choose to change the result of a Skill Check or Damage roll, by switching the faces of the rolled 2d to the opposite sides."},{"title":"◯ Knight's Fundamentals","description":"The Knight has learned the Combat Feats [ Decoy Attack I ] and [ Cover I ]."},{"title":"⏩ △ Techniques","description":"The Knight can use Techniques [ Beetleskin ] and [ Bear Muscle ]."}],"lootTable":[{"roll":"2 - 6","loot":"Nothing"},{"roll":"7 - 11","loot":"Bag of Silver (100G/- ) x 1d"},{"roll":"12+","loot":"Gems (150G/Gold A) x1d"}]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Evil Knight","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"attribute":"mp"},"light":{"negative":false,"priority":0,"alpha":0.5,"angl