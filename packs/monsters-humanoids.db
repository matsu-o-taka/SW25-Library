{"_id":"08CsJdwcKlGpwQvj","name":"Abyss Gazer Betrayer","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:abyss-gazer-betrayer","level":7,"monsterType":"Humanoid","intelligence":"Average","perception":"Five senses","disposition":"Hostile","soulscars":0,"languages":"Trade Common, Regional Dialect, Arcana, Daemonic","habitat":"Various","reputation":10,"weakness":0,"weakPoint":"None","initiative":13,"movementSpeed":"14","fortitude":"9(16)","willpower":"10(17)","source":"AB, p. 128","description":"This is an Abyss Gazer who uses Abyssal Magic at a high level. They use their magic solely to achieve their own goals and ambitions, rarely helping others.\n\nThey have their own theories and hypotheses from studying Shallow Abysses, and because they often venture into it willingly, they can sometimes be spotted within a Shallow.","combatStyles":[{"style":"Weapon","accuracy":"8(15)","damage":"2d+8","evasion":"&#32;","defense":8,"hp":{"value":5,"max":5},"mp":{"value":32,"max":32}}],"uniqueSkills":[{"title":"► Abyssal Magic 7 Level / Magic Power 10 (17)","description":"Enhanced effect can be used up to 2 rounds."},{"title":"◯🗨Magic Aptitude","description":"They can use Combat Feats [ Multi-Action ], [ Targeting ], and [ Metamagic/Targets ]."},{"title":"◯Sword's Grace/Change Fate","description":"Once per day, they may change the result of a Skill Check or Damage roll, by switching the faces of the rolled 2d to the opposite sides and adding +1 to it."}],"lootTable":[{"roll":"Always","loot":"Daemon's Blood (100G/Red A)"},{"roll":"Always","loot":"Crystallized Daemon's Blood (800G/Red A)"},{"roll":"2 - 9","loot":"Nothing"},{"roll":"10+","loot":"Bag of Silver (100G/-) x 2d"}]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Abyss Gazer Betrayer","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"attribute":"mp"},"light":{"negative":false,"priority":0,"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}},"sight":{"enabled":false,"range":0,"angle":360,"visionMode":"basic","color":null,"attenuation":0.1,"brightness":0,"saturation":0,"contrast":0},"detectionModes":{},"occludable":{"radius":0},"ring":{"enabled":false,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":null}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"flags":{},"randomImg":false,"appendNumber":false,"prependAdjective":false},"items":[],"effects":[],"sort":0}
{"_id":"10ZAro7w95JrPOv0","name":"Emerging Sniper","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:emerging-sniper","level":5,"monsterType":"Humanoid","intelligence":"Average","perception":"Five senses","disposition":"Neutral","soulscars":0,"languages":"Trade Common, Regional Dialect","habitat":"Various","reputation":8,"weakness":0,"weakPoint":"None","initiative":13,"movementSpeed":"15","fortitude":"7 (14)","willpower":"7 (14)","source":"Monstrous Lore p. 219","description":"This is an inexperienced shooter who shows promising abilities. They judge situations accurately and drive their opponents into a tight corner with high damage using their sniping.","combatStyles":[{"style":"Bow","accuracy":"8 (15)","damage":"2d+7","evasion":"6 (13)","defense":4,"hp":{"value":41,"max":41},"mp":{"value":12,"max":12}}],"uniqueSkills":[{"title":"◯ Bow","description":"An attack with a Bow is treated as a Shooting Attack with a &quot;Range: 2 (30m)&quot;."},{"title":"◯ Targeting","description":"Stray shots cannot occur."},{"title":"► Snipe","description":"Emerging Sniper focuses on a specific target. On its next turn, if it makes a Shooting Attack against the target and successfully hits with a roll of 3 or more over the opponent's Evasion check, the combined damage will be doubled."},{"title":"◯ Sword's Grace/Change Fate","description":"Once per day, they may choose to change the result of a Skill Check or Damage roll by switching the faces of the rolled 2d to the opposite sides."}],"lootTable":[{"roll":"2 - 4","loot":"Nothing"},{"roll":"5 - 8","loot":"Bag of Silver (30G) x 1d"},{"roll":"9+","loot":"Gem (150G/Gold A) x 1d"}]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Emerging Sniper","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"attribute":"mp"},"light":{"negative":false,"priority":0,"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}},"sight":{"enabled":false,"range":0,"angle":360,"visionMode":"basic","color":null,"attenuation":0.1,"brightness":0,"saturation":0,"contrast":0},"detectionModes":{},"occludable":{"radius":0},"ring":{"enabled":false,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":null}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"flags":{},"randomImg":false,"appendNumber":false,"prependAdjective":false},"items":[],"effects":[],"sort":0}
{"_id":"1FNn6elO6qlHkyVL","name":"Skald","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:skald","level":6,"monsterType":"Humanoid","intelligence":"Average","perception":"Five senses","disposition":"Neutral","soulscars":0,"languages":"Trade Common, Arcana, Sylvan, Youma, Barbaric","habitat":"Various","reputation":9,"weakness":0,"weakPoint":"None","initiative":13,"movementSpeed":"16","fortitude":"8 (15)","willpower":"9 (16)","source":"CR II p. 410","description":"This is a battlefield bard who fights with spellsongs and finales. They are also trained as warriors to stand in the front.","combatStyles":[{"style":"Weapon","accuracy":"8 (15)","damage":"2d+9","evasion":"8 (15)","defense":5,"hp":{"value":35,"max":35},"mp":{"value":20,"max":20}}],"uniqueSkills":[{"title":"► Basic Spellsongs 5 Level/8 (15)/All area (50m Radius)","description":""},{"title":"► [ Finale: Beast's Roar ]/8 (15)/Willpower/Half","description":"Uses [Finale: Beast's Roar] at &quot;Range: 2 (50m)&quot;, dealing 2d+6 bludgeoning magic damage to up to 3 targets.\nThis unique skill can be used only on the turn immediately after using [ ► Basic Spellsongs] two or more times in succession."},{"title":"◯ Sword's Grace/Change Fate","description":"Once per day, they may change the result of a Skill Check or Damage roll by switching the faces of the rolled 2d to the opposite sides and adding +1."}],"lootTable":[{"roll":"2 - 5","loot":"Weapon (50G/Black White B)"},{"roll":"6 - 9","loot":"Fine Instrument (100G/Black White A)"},{"roll":"10 - 12","loot":"Luxury Instrument (800G/Black White A)"},{"roll":"13+","loot":"Rare Instrument (3,600G/Black White S)"}]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Skald","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"attribute":"mp"},"light":{"negative":false,"priority":0,"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}},"sight":{"enabled":false,"range":0,"angle":360,"visionMode":"basic","color":null,"attenuation":0.1,"brightness":0,"saturation":0,"contrast":0},"detectionModes":{},"occludable":{"radius":0},"ring":{"enabled":false,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":null}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"flags":{},"randomImg":false,"appendNumber":false,"prependAdjective":false},"items":[],"effects":[],"sort":0}
{"_id":"1t9DJngIoWCQXaFr","name":"Fallen Wizard","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:fallen-wizard","level":3,"monsterType":"Humanoid","intelligence":"Average","perception":"Five Senses","disposition":"Neutral","soulscars":0,"languages":"Trade Common, Regional Dialect, Learned Magic Language","habitat":"Various","reputation":6,"weakness":0,"weakPoint":"None","initiative":11,"movementSpeed":"14/-","fortitude":"4 (11)","willpower":"5 (12)","source":"GR, Battle Mastery p. 152","description":"A Humanoid magician who has lost sight of the true purpose of magic and uses their power for selfish gain. The GM should decide on their specific magic type in advance. If this monster appears in solo play, it should be treated as having learned Truespeech Magic , unless otherwise specified.","combatStyles":[{"style":"Weapon","accuracy":"4 (11)","damage":"2d+2","evasion":"4 (11)","defense":3,"hp":{"value":17,"max":17},"mp":{"value":23,"max":23}}],"uniqueSkills":[{"title":"◯ Sword's Grace/Change Fate","description":"Once per day, they may choose to change the result of a Skill Check or Damage roll, by switching the faces of the rolled 2d to the opposite sides."},{"title":"► Magic (1 System) Level 3 / Magic Power 5 (12)","description":"The Wizard has mastered one of the following: Truespeech Magic , Spiritualism Magic , Fairy Magic , Magitech , Nature Magic or Summoning Arts up to Level 3."},{"title":"◯ 🗨 Magical Aptitude","description":"The Wizard has learned the Combat Feats [ Targeting ] and [ Metamagic/Targets ]."}],"lootTable":[{"roll":"2 - 9","loot":"Nothing"},{"roll":"10+","loot":"Bag of Silver (50G/-) x 1d"}]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Fallen Wizard","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"attribute":"mp"},"light":{"negative":false,"priority":0,"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}},"sight":{"enabled":false,"range":0,"angle":360,"visionMode":"basic","color":null,"attenuation":0.1,"brightness":0,"saturation":0,"contrast":0},"detectionModes":{},"occludable":{"radius":0},"ring":{"enabled":false,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":null}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"flags":{},"randomImg":false,"appendNumber":false,"prependAdjective":false},"items":[],"effects":[],"sort":0}
{"_id":"42Xm9bUOENAQ8MZd","name":"Abyss-Entranced Gazer","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:abyss-entranced-gazer","level":6,"monsterType":"Humanoid","intelligence":"Average","perception":"Five Senses","disposition":"Neutral","soulscars":0,"languages":"Trade Common, Regional Dialect, Daemonic","habitat":"Various, Shallow Abysses","reputation":9,"weakness":0,"weakPoint":"None","initiative":14,"movementSpeed":"14/-","fortitude":"8 (15)","willpower":"9 (16)","source":"Natural History of Ursyla p. 135","description":"Among the Abyss Gazers who use the power of Abyss, there are evil ones who actively protect and seek to expand Shallow Abysses, which serves as the source of their power.\n\nThese Abyss Gazers will attack and interfere with adventurers heading to subjugate Shallow Abysses or lurk in the Shallows to hone their skills and eliminate intruders. While such misguided Abyss Gazers are rare, they can become formidable enemies if confronted.","combatStyles":[{"style":"Weapon","accuracy":"9 (16)","damage":"2d+4","evasion":"8 (15)","defense":4,"hp":{"value":51,"max":51},"mp":{"value":36,"max":36}}],"uniqueSkills":[{"title":"► Abyssal Magic Level 6 / Magic Power 9 (16)","description":"Enhanced effects can be used until the second round."},{"title":"🗨Magic Aptitude","description":"They can use the Combat Feat [ Metamagic/Targets ]."},{"title":"🗨Mana Strike = +9 points","description":"Increases damage by +9 points. As a risk, they receive a -2 penalty modifier to their Fortitude and Willpower checks until the next turn."},{"title":"◯ Painful Strike","description":"If the result of the 2d roll for damage determination is 9 or higher, increase damage by an additional +4 points."},{"title":"◯ Sword's Grace/Change Fate","description":"Once per day, they may choose to change the result of a Skill Check or Damage roll by switching the faces of the rolled 2d to the opposite sides and adding +1."},{"title":"◯ Mako Stone = 5 points x 3","description":"Possesses three Mako Stones worth 5 points each, which can be used to reduce MP consumption when using Abyssal Magic."},{"title":"◯ Delicate Loot","description":"The number of loot Mako Stones (5 points) is reduced by the number of Mako Stones this monster used during combat (minimum 0). Additionally, this loot cannot be targeted by Essence Weaving [ Mass Looting ]."}],"lootTable":[{"roll":"Always","loot":"Mako Stone (5 points) (250G/-) x 3"},{"roll":"2 - 10","loot":"Keen Weapon (100G/Black White A)"},{"roll":"11+","loot":"Well-Kept Weapon (1,000G/Black White S)"}]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Abyss-Entranced Gazer","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"attribute":"mp"},"light":{"negative":false,"priority":0,"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}},"sight":{"enabled":false,"range":0,"angle":360,"visionMode":"basic","color":null,"attenuation":0.1,"brightness":0,"saturation":0,"contrast":0},"detectionModes":{},"occludable":{"radius":0},"ring":{"enabled":false,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":null}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"flags":{},"randomImg":false,"appendNumber":false,"prependAdjective":false},"items":[],"effects":[],"sort":0}
{"_id":"4oEInGcup73TdKwS","name":"Abyss Crosser","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:abyss-crosser","level":10,"monsterType":"Humanoid","intelligence":"Average","perception":"Five senses","disposition":"Neutral","soulscars":0,"languages":"Trade Common, Regional Dialect","habitat":"Various","reputation":13,"weakness":0,"weakPoint":"None","initiative":17,"movementSpeed":"20","fortitude":"13(20)","willpower":"14(21)","source":"AB, p. 129","description":"As one who knows Shallow Abysses, this is an expert in mastering both the powers of the Abyss Gazer and the Dark Hunter , specializing in Shallow strategies.\n\nWhile possessing abilities high enough to complete missions solo, this results in intense HP and MP consumption, which they compensate for through items and their own magic.","combatStyles":[{"style":"Weapon","accuracy":"13(20)","damage":"2d+13","evasion":"&#32;","defense":13,"hp":{"value":10,"max":10},"mp":{"value":32,"max":32}}],"uniqueSkills":[{"title":"► Abyssal Magic 9 Level/Magic Power 12(19)","description":"Enhanced effect is used up to 2 rounds."},{"title":"◯🗨Magic Aptitude","description":"They can use Combat Feats [ Multi-Action ], [ Targeting ], and [ Metamagic/Targets ]."},{"title":"🗨Mana Strike = +12 damage","description":"An Abyss Crosser may deal an additional +12 damage to their next melee attack. If they do, at risk, they receive a -2 penalty to Fortitude and Willpower checks until their next turn."},{"title":"◯Thrown Attack","description":"Weapon attacks can also be treated as thrown attacks with &quot;Range/Area: 2 (20m) / Shot .&quot;"},{"title":"⏩Silver Thread","description":"Retrieves the weapon used in the throwing attack back to hand. Consumes 2 HP before the throwing attack. If this action is not taken, this monster loses the weapon and damage is reduced by 6 points thereafter (minimum 0)."},{"title":"►Light Spear that Pierces the Abyss / 13 (20) / Willpower / Half","description":"Creates and launches a spear of light. Within &quot;Range/Area: 1 (10m) / Shot ,&quot; deals &quot;Power 30+13 / Critical Threshold 10&quot; Energy magic damage to 1 character.\nIf the target is Undead or Daemon, the Power is changed to 60.\nUsing this ability consumes 2d HP points."},{"title":"◯Mako Stones","description":"Possesses 3 Mako Stones with 10 MP remaining each, which can be used when consuming MP.\nAny Mako Stones that remain unused when this character's HP falls below 0 can be automatically acquired during Loot Determination. These Mako Stones cannot be targeted by [ Mass Looting ]."},{"title":"◯Sword's Grace/Change Fate","description":"Once per day, they may change the result of a Skill Check or Damage roll by switching the faces of the rolled 2d to the opposite sides and adding +1 to it."}],"lootTable":[{"roll":"Always","loot":"Remaining Mako Stones"},{"roll":"Always","loot":"Crystallized Daemon's Blood (800G/Red A) x 1d"},{"roll":"2 - 8","loot":"Gem (150G/Gold A) x 2d"},{"roll":"9+","loot":"Large Gem (4,000G/Gold S)"}]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Abyss Crosser","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"attribute":"mp"},"light":{"negative":false,"priority":0,"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}},"sight":{"enabled":false,"range":0,"angle":360,"visionMode":"basic","color":null,"attenuation":0.1,"brightness":0,"saturation":0,"contrast":0},"detectionModes":{},"occludable":{"radius":0},"ring":{"enabled":false,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":null}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"flags":{},"randomImg":false,"appendNumber":false,"prependAdjective":false},"items":[],"effects":[],"sort":0}
{"_id":"6YQzeZBqlNzspWT4","name":"Longbowman","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:longbowman","level":5,"monsterType":"Humanoid","intelligence":"Average","perception":"Five Senses","disposition":"Neutral","soulscars":0,"languages":"Trade Common, Regional Dialect","habitat":"Various","reputation":8,"weakness":0,"weakPoint":"None","initiative":12,"movementSpeed":"16/-","fortitude":"6 (13)","willpower":"7 (14)","source":"GR, Battle Mastery p. 153","description":"Humans wielding longbows that are taller than their own body. Boasting considerable range and Strength that can be further enhanced through Techniques, they become a formidable foe that cannot be ignored.","combatStyles":[{"style":"Bow","accuracy":"7 (14)","damage":"2d+8","evasion":"5 (12)","defense":5,"hp":{"value":33,"max":33},"mp":{"value":15,"max":15}}],"uniqueSkills":[{"title":"◯ Sword's Grace/Change Fate","description":"Once per day, they may choose to change the result of a Skill Check or Damage roll, by switching the faces of the rolled 2d to the opposite sides."},{"title":"◯ Bow","description":"Bow attacks are treated as Ranged attacks with Range 2 (50m)."},{"title":"◯ Targeting","description":"Stray shots cannot occur."},{"title":"⏩ △ Techniques","description":"Can use the techniques [ Gazelle Feet ], [ Cat's Eyes ], [ Strong Blood ], [ Bear Muscle ], and [ Beetleskin ]."},{"title":"◯ Mako Stone","description":"The Longbowman possesses 5 Mako Stones with 3 MP remaining each, which can be consumed when using skills or transferred to other characters. Mako Stones that are not consumed before the Longbowman's HP falls below 0 are automatically acquired when determining loot."}],"lootTable":[{"roll":"Always","loot":"Remaining Mako Stones (See above)"},{"roll":"2 - 6","loot":"Nothing"},{"roll":"7 - 11","loot":"Bag of Silver (100G/-) x 1d"},{"roll":"12+","loot":"Gems (150G/Gold A) x 1d"}]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Longbowman","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"attribute":"mp"},"light":{"negative":false,"priority":0,"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}},"sight":{"enabled":false,"range":0,"angle":360,"visionMode":"basic","color":null,"attenuation":0.1,"brightness":0,"saturation":0,"contrast":0},"detectionModes":{},"occludable":{"radius":0},"ring":{"enabled":false,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":null}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"flags":{},"randomImg":false,"appendNumber":false,"prependAdjective":false},"items":[],"effects":[],"sort":0}
