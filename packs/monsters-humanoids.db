{"_id":"FMA5DPmGrbyH1BDS","name":"Abyss Glimpser","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:abyss-glimpser","level":1,"monsterType":"Humanoid","intelligence":"Average","perception":"Five senses","disposition":"Neutral","soulscars":0,"languages":"Trade Common, Regional Dialect, Daemonic","habitat":"Various","reputation":4,"weakness":0,"weakPoint":"None","initiative":7,"movementSpeed":"12","fortitude":"2(9)","willpower":"3(10)","source":"AB, p. 127","description":"This is an Abyssal Magic user - an ordinary person was captured by the Shallow Abyss and awakened their talent to use magic within it.\n\nEach individual interprets their power differently - some are unaware of their abilities, while others mistakenly believe their power is omnipotent.","combatStyles":[{"style":"Weapon","accuracy":"2(9)","damage":"2d","evasion":"&#32;","defense":2,"hp":{"value":3,"max":3},"mp":{"value":32,"max":32}}],"uniqueSkills":[{"title":"► Abyssal Magic 1 Level / Magic Power 3 (10)","description":"Enhanced effects are only used for 1 round."},{"title":"◯Magic Aptitude","description":"They can use Combat Feat [ Targeting ]."},{"title":"◯Sword's Grace/Change Fate","description":"Once per day, they may choose to change the result of a Skill Check or Damage roll, by switching the faces of the rolled 2d to the opposite sides."}],"lootTable":[{"roll":"2 - 8","loot":"Nothing"},{"roll":"9+","loot":"Bag of Silver (50G/-)"}]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Abyss Glimpser","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"attribute":"mp"},"light":{"negative":false,"priority":0,"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"a