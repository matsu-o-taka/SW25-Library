{"_id":"I18RjvO5OnvdjqXi","name":"Dedicated Wizard","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:dedicated-wizard","level":5,"monsterType":"Humanoid","intelligence":"Average","perception":"Five Senses","disposition":"Neutral","soulscars":0,"languages":"Trade Common, Regional Dialect, Magic System Learned","habitat":"Various","reputation":8,"weakness":0,"weakPoint":"None","initiative":12,"movementSpeed":"15","fortitude":"7 (14)","willpower":"8 (15)","source":"Monstrous Lore p. 219","description":"This is a human wizard with a certain amount of experience. They may be encountered in a variety of situations.","combatStyles":[{"style":"Staff","accuracy":"4 (11)","damage":"2d+1","evasion":"5 (12)","defense":4,"hp":{"value":29,"max":29},"mp":{"value":36,"max":36}}],"uniqueSkills":[{"title":"► Magic (1 System) 5 Level/Magic Power 8 (15).","description":"Dedicated Wizard has mastered any one of the following at the 5th level: Truespeech Magic , Spiritualism Magic , Divine Magic , Fairy Magic , Nature Magic , or Summoning Arts .\nThe types used in Fairy Magic are generally &quot;Fire&quot;, &quot;Water/Ice&quot;, &quot;Wind&quot;, and &quot;Light&quot;, but the GM may arbitrarily change to any four."},{"title":"◯ Sword's Grace/Change Fate","description":"Once per day, they may change the result of a Skill Check or Damage roll by switching the faces of the rolled 2d to the opposite sides."}],"lootTable":[{"roll":"2 - 3","loot":"Nothing"},{"roll":"4 - 7","loot":"Bag of Silver (50G) x 1d"},{"roll":"8 - 10","loot":"Bag of Silver (100G) x 1d"},{"roll":"11+","loot":"Gem (150G/Gold A) x 1d"}]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Dedicated Wizard","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"attribute":"mp"},"light":{"negative":false,"priority":0,"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}},"sight":{"enabled":false,"range":0,"angle":360,"visionMode":"basic","color":null,"attenuation":0.1,"brightness":0,"saturation":0,"contrast":0},"detectionModes":{},"occludable":{"radius":0},"ring":{"enabled":false,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":null}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"flags":{},"randomImg":false,"appendNumber":false,"prependAdjective":false},"items":[],"effects":[],"sort":0}
{"_id":"IafK80Vpa3sXJmvy","name":"Mounted Bandit","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:mounted-bandit","level":3,"monsterType":"Humanoid","intelligence":"Average","perception":"Five senses","disposition":"Neutral","soulscars":0,"languages":"Trade Common, Regional Dialect","habitat":"Various","reputation":6,"weakness":0,"weakPoint":"None","initiative":11,"movementSpeed":"30 (4 Legs)","fortitude":"5 (12)","willpower":"5 (12)","source":"CR III p. 427","description":"Riding on horseback, these thugs attack travelers and peddlers. Armed with spears, they block the way of their prey with their horses, threaten them, and take their money and goods. They work in groups of up to ten.","combatStyles":[{"style":"Spear (Rider)","accuracy":"5 (12)","damage":"2d+6","evasion":"5 (12)","defense":4,"hp":{"value":25,"max":25},"mp":{"value":13,"max":13}},{"style":"Hooves (Horse)","accuracy":"4 (11)","damage":"2d+1","evasion":"3 (10)","defense":2,"hp":{"value":26,"max":26},"mp":{"value":9,"max":9}}],"uniqueSkills":[{"title":"All Sections","description":""},{"title":"◯ Dismounting","description":"This monster's Rider section is mounted on the Horse section. If the Rider is dismounted, all sections suffer a -1 penalty on all Skill Checks and have their damage reduced by -1 point.\nSee the Riding Rules (at CR III, p. 84) for how to dismount and mount back on a mount. If not on the mount, this monster's Normal Speed becomes &quot;12&quot;."},{"title":"Rider","description":""},{"title":"◯ Sword's Grace/Change Fate","description":"Once per day, they may choose to change the result of a Skill Check or Damage roll by switching the faces of the rolled 2d to the opposite sides."}],"lootTable":[{"roll":"2 - 6","loot":"Nothing"},{"roll":"7 - 12","loot":"Weapon (30G/Black White B)"},{"roll":"13+","loot":"Bag of Silver (50G) x 1d"}]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Mounted Bandit","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"attribute":"mp"},"light":{"negative":false,"priority":0,"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}},"sight":{"enabled":false,"range":0,"angle":360,"visionMode":"basic","color":null,"attenuation":0.1,"brightness":0,"saturation":0,"contrast":0},"detectionModes":{},"occludable":{"radius":0},"ring":{"enabled":false,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":null}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"flags":{},"randomImg":false,"appendNumber":false,"prependAdjective":false},"items":[],"effects":[],"sort":0}
{"_id":"JQfUnTQ59mUqqv9r","name":"Evil God's Apostle","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:evil-gods-apostle","level":8,"monsterType":"Humanoid","intelligence":"Average","perception":"Five Senses","disposition":"Hostile","soulscars":0,"languages":"Trade Common, Daemonic, Regional Dialect","habitat":"Various","reputation":11,"weakness":0,"weakPoint":"None","initiative":14,"movementSpeed":"14/-","fortitude":"10 (17)","willpower":"11 (18)","source":"GR, Battle Mastery p. 154","description":"A group of humanoid heretics who are recognized by their followers as the embodiment of their doctrine. They excel at trickery and theatrics, and will rarely allow an opportunity for a head on confrontation.","combatStyles":[{"style":"Weapon","accuracy":"9 (16)","damage":"2d+8","evasion":"9 (16)","defense":6,"hp":{"value":56,"max":56},"mp":{"value":57,"max":57}}],"uniqueSkills":[{"title":"◯ Sword's Grace/Change Fate","description":"Once per day, they may choose to change the result of a Skill Check or Damage roll, by switching the faces of the rolled 2d to the opposite sides."},{"title":"► Divine Magic 8 Level / Magic Power 11 (18)","description":""},{"title":"◯ 🗨 Magic Aptitude","description":"The Apostle has learned the Combat Feats [ Targeting ], [ Metamagic/Targets ], [ Multi-Action ] and [ Cheat Cast I ]."},{"title":"🗨 Mana Strike = +11 Damage","description":"May deal an additional +11 Damage on their next melee attack. As a risk, the Apostle suffers a -2 penalty to Fortitude and Willpower checks."},{"title":"◯ Mako Stone","description":"The Apostle possesses 3 Mako Stones with 5 MP remaining each, which can be consumed when using skills or transferred to other characters.\nMako Stones that are not consumed before the Apostle's HP falls below 0 are automatically acquired when determining loot."}],"lootTable":[{"roll":"Always","loot":"Remaining Mako Stones"},{"roll":"Always","loot":"Holy Symbol of Evil God (600G/Black/White A)"},{"roll":"2 - 6","loot":"Bag of Silver (100G/-) x2d"},{"roll":"7 - 12","loot":"Bag of Silver (200G/-) x2d"},{"roll":"13+","loot":"Strange Holy Symbol (3,300G/White S)"}]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Evil God's Apostle","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"attribute":"mp"},"light":{"negative":false,"priority":0,"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}},"sight":{"enabled":false,"range":0,"angle":360,"visionMode":"basic","color":null,"attenuation":0.1,"brightness":0,"saturation":0,"contrast":0},"detectionModes":{},"occludable":{"radius":0},"ring":{"enabled":false,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":null}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"flags":{},"randomImg":false,"appendNumber":false,"prependAdjective":false},"items":[],"effects":[],"sort":0}
{"_id":"Jx47JhQ25R5ojB7x","name":"Battle-Hardened Strategist","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:battle-hardened-strategist","level":9,"monsterType":"Humanoid","intelligence":"Average","perception":"Five senses","disposition":"Neutral","soulscars":0,"languages":"Trade Common, Regional Dialect","habitat":"Various","reputation":12,"weakness":0,"weakPoint":"None","initiative":17,"movementSpeed":"15","fortitude":"13(20)","willpower":"11(18)","source":"AB, p. 129","description":"This is a renowned strategist Humanoid Tactician with extensive command experience across numerous battlefields. They prefer tactics that inspire allies while personally fighting on the battlefield. Highly skilled at protecting their army's leaders and escort targets, they are well-respected by both allies and enemies alike.","combatStyles":[{"style":"Weapon","accuracy":"13(20)","damage":"2d+12","evasion":"&#32;","defense":11,"hp":{"value":14,"max":14},"mp":{"value":32,"max":32}}],"uniqueSkills":[{"title":"◯🗨△Guard's Mindset","description":"Learns the Combat Feats [ Block ] and [ Cleave ]."},{"title":"🗨Cleave II","description":"It attacks with a weapon up to 5 characters within the skirmish in which it resides."},{"title":"⏩Stratagems &amp; Maneuvers / All Areas (30m radius)","description":"Uses Stratagem [Ironclad Defense III: Armored Core] (reducing physical and magical damage by 1 point). Every 3rd turn, uses [Maneuver: Careful Guard II] (reducing physical and magical damage by 7 points)."},{"title":"◯Sword's Grace/Change Fate","description":"Once per day, they may change the result of a Skill Check or Damage roll, by switching the faces of the rolled 2d to the opposite sides and adding +1 to it."}],"lootTable":[{"roll":"Always","loot":"Well-Kept Weapon (1,000G/Black White S)"},{"roll":"2 - 8","loot":"Bag of Silver (300G/-) x 1d"},{"roll":"9+","loot":"Bag of Silver (300G/-) x 2d"}]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Battle-Hardened Strategist","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"attribute":"mp"},"light":{"negative":false,"priority":0,"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}},"sight":{"enabled":false,"range":0,"angle":360,"visionMode":"basic","color":null,"attenuation":0.1,"brightness":0,"saturation":0,"contrast":0},"detectionModes":{},"occludable":{"radius":0},"ring":{"enabled":false,"colors":{"ring":null,"background":null},"effects":1,"subject":{"scale":1,"texture":null}},"turnMarker":{"mode":1,"animation":null,"src":null,"disposition":false},"movementAction":null,"flags":{},"randomImg":false,"appendNumber":false,"prependAdjective":false},"items":[],"effects":[],"sort":0}
{"_id":"OSgNE9o4w4JOpZFh","name":"Thoughtful Forest Master","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:thoughtful-forest-master","level":8,"monsterType":"Humanoid","intelligence":"High","perception":"Five senses","disposition":"Hostile","soulscars":0,"languages":"Trade Common, Regional Dialect, Arcana","habitat":"Various","reputation":11,"weakness":0,"weakPoint":"None","initiative":14,"movementSpeed":"14","fortitude":"10 (17)","willpower":"11 (18)","source":"Monstrous Lore p. 220","description":"This is a Druid who is compassionate towards animals and plants, and uses their power to protect their friends.","combatStyles":[{"style":"Staff","accuracy":"10 (17)","damage":"2d+6","evasion":"9 (16)","defense":5,"hp":{"value":67,"max":67},"mp":{"value":44,"max":44}}],"uniqueSkills":[{"title":"► Nature Magic 8 Level/Magic Power 11 (18)","description":""},{"title":"◯ 🗨 Magic Aptitude","description":"They can use the Combat Feats [ Targeting ], [ Hawk Eye ] and [ Universal Metamagic ]."},{"title":"◯ Sword's Grace/Change Fate","description":"Once per day, they may change the result of a Skill Check or Damage roll, by switching the faces of the rolled 2d to the opposite sides and adding +1 to it."}],"lootTable":[{"roll":"Always","loot":"Gem (600G/Gold A)"},{"roll":"2 - 9","loot":"Nothing"},{"roll":"10+","loot":"Gem (600G/Gold A) x 1d"}]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Thoughtful Forest Master","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"attribute":"mp"},"light":{"negative":false,"priority":0,"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"