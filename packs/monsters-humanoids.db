{"_id":"DvWtzLaOWFKTL1Gp","name":"Runaway Carriage Robbers","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:runaway-carriage-robbers","level":5,"monsterType":"Humanoid","intelligence":"Average","perception":"Five Senses (Darkvision)","disposition":"Hostile","soulscars":0,"languages":"Trade Common, Regional Dialect","habitat":"Various","reputation":11,"weakness":0,"weakPoint":"None","initiative":13,"movementSpeed":"18 (4 Legs and Wheeled)/-","fortitude":"7 (14)","willpower":"6 (13)","source":"BM","description":"These are Humanoid robbers who drive a horse-drawn cart. They often attack peddlers and other travelers along the roads.","combatStyles":[{"style":"Weapon (Driver)","accuracy":"7 (14)","damage":"2d+5","evasion":"6 (13)","defense":4,"hp":{"value":36,"max":36},"mp":{"value":11,"max":11}},{"style":"Hooves (Horse)","accuracy":"6 (13)","damage":"2d+3","evasion":"5 (12)","defense":4,"hp":{"value":34,"max":34},"mp":{"value":11,"max":11}},{"style":"None (Cart)","accuracy":"-","damage":"-","evasion":"4 (11)","defense":5,"hp":{"value":40,"max":40},"mp":{"value":0,"max":0}}],"uniqueSkills":[{"title":"Driver","description":""},{"title":"◯ Sword's Grace/Change Fate","description":"Once per day, they may choose to change the result of a Skill Check or Damage roll, by switching the faces of the rolled 2d to the opposite sides."},{"title":"Horse","description":""},{"title":"◯ Downswing","description":"The Rider section deals an extra +2 Damage.\nWhen the Horse section falls to 0 HP or lower, this unique skill is lost."},{"title":"Cart","description":""},{"title":"◯ Poison Immunity, Disease Immunity, Psychic Immunity, Curse Immunity","description":""},{"title":"◯ Mounted = 4 Characters","description":"The cart can carry up to four characters. (See CR III, p. 91)."}],"lootTable":[{"roll":"Always","loot":"Empty Wooden Chest (30G/Green White B)"},{"roll":"2 - 10","loot":"Nothing"},{"roll":"11+","loot":"Gems (150G/Gold A) x 1d"}]},"img":"i