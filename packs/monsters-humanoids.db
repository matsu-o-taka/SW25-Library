{"_id":"FipwQzelhiZI2lRk","name":"Promising Magic Warrior","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:promising-magic-warrior","level":4,"monsterType":"Humanoid","intelligence":"Average","perception":"Five senses","disposition":"Neutral","soulscars":0,"languages":"Trade Common, Arcana, Regional Dialect","habitat":"Various","reputation":7,"weakness":0,"weakPoint":"None","initiative":11,"movementSpeed":"12","fortitude":"7 (14)","willpower":"7 (14)","source":"VC","description":"This is a promising magical warrior. They are not yet proficient as either a warrior or a wizard, but they are capable of performing both roles at a minimum level.","combatStyles":[{"style":"Weapon","accuracy":"6 (13)","damage":"2d+6","evasion":"5 (12)","defense":5,"hp":{"value":30,"max":30},"mp":{"value":18,"max":18}}],"uniqueSkills":[{"title":"► Truespeech Magic 3 Level/Magic Power 5 (12)","description":""},{"title":"◯ Magic Aptitude","description":"They can use the Combat Feat [ Targeting ]."},{"title":"🗨 Mana Strike = +5 damage","description":"May deal an additional +5 damage to their next melee attack. At risk, they take a -2 penalty to their Fortitude and Willpower checks."},{"title":"◯ Sword's Grace/Change Fate","description":"Once per day, they may choose to change the result of a Skill Check or Damage roll, by switching the faces of the rolled 2d to the opposite sides."}],"lootTable":[{"roll":"Always","loot":"High-quality Weapon (150G/Black White A)"},{"roll":"2 - 9","loot":"Nothing"},{"roll":"10+","loot":"Gem (150G/Gold A) x 1d"}]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Promising Magic Warrior","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"at