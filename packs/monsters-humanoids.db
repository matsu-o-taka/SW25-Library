{"_id":"SL07Bw6atgvzd7Xs","name":"Skilled Mercenary","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:skilled-mercenary","level":5,"monsterType":"Humanoid","intelligence":"Average","perception":"Five senses","disposition":"Neutral","soulscars":0,"languages":"Trade Common","habitat":"Various","reputation":8,"weakness":0,"weakPoint":"None","initiative":14,"movementSpeed":"20","fortitude":"8 (15)","willpower":"7 (14)","source":"CR I p. 431","description":"With sword and shield at the ready, this mercenary relies on his sword arm and leather armor to protect him from the dangers of the road.","combatStyles":[{"style":"Sword","accuracy":"8 (15)","damage":"2d+10","evasion":"8 (15)","defense":5,"hp":{"value":52,"max":52},"mp":{"value":12,"max":12}}],"uniqueSkills":[{"title":"🗨 Quick Slash","description":"Gains +1 to Accuracy. This ability has no effect on characters equipped with metal armor."},{"title":"🗨 Power Strike I","description":"They can deal an additional 4 damage on their next attack. However, any Evasion Check made by them this turn receives a -2 penalty."},{"title":"◯ Sword's Grace/Change Fate","description":"Once per day, they may choose to change the result of a Skill Check or Damage roll by switching the faces of the rolled 2d to the opposite sides."}],"lootTable":[{"roll":"2 - 3","loot":"Nothing"},{"roll":"4 - 7","loot":"Bag of Silver (30G) x 1d"},{"roll":"8 - 9","loot":"Bag of Silver (100G) x 1d"},{"roll":"10+","loot":"Gem (150G/Gold A) x 1d"}]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Skilled Mercenary","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"attribute":"mp"},"light":{"negative":false,"priority":0,"alpha":0.5,"ang