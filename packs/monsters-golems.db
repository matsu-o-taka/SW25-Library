{"_id":"JvYdAKpu0fbiyK3B","name":"Bone Animal","type":"monster","system":{"revealed":false,"sourceUrl":"https://sw25.wikidot.com/monster:bone-animal","level":4,"monsterType":"Golem","intelligence":"Servant","perception":"Magic","disposition":"Instructed","soulscars":0,"languages":"None","habitat":"Various","reputation":12,"weakness":15,"weakPoint":"Bludgeoning damage +3 points","initiative":12,"movementSpeed":"14 (4 Legs)","fortitude":"6 (13)","willpower":"6 (13)","source":"CR II p. 421","description":"Materials: Enchanted Animal Bones (300/500)\n\nThis is a golem made from the bones of an animal, and all that remains is the skeleton of the original animal.","combatStyles":[],"uniqueSkills":[{"title":"◯ Bone Body","description":"Bone Animal is immune to criticals from edged weapons.\nMaximum of Enhancing Items = 3\nTiger's Eye Rivet (Small) (150) ( ◯ Continuous Attack)\n└ Golden Tiger's Eye Rivet (Small) (300) ( ◯ Continuous Attack II)\nSpinel Horn (Small) (150) ( ► Charge)\nAmber Eye (Small) (500) ( ◯ Ultimate Aim = +4 Accuracy)\nGarnet of Vitality (Small) (200) ( ◯ HP Enhancement = Max HP +5)\nRed Iron Blood (Small) (100) ( ◯ Mobility Enhancement = Movement +5)\n2d |\nLoot |\n2 - 8 |\nNothing |\n9+ |\nEnchanted Animal Bones (250G/Gold Red A) |"}],"lootTable":[]},"img":"icons/svg/mystery-man.svg","prototypeToken":{"name":"Bone Animal","displayName":0,"actorLink":false,"width":1,"height":1,"depth":1,"texture":{"src":"icons/svg/mystery-man.svg","anchorX":0.5,"anchorY":0.5,"fit":"contain","scaleX":1,"scaleY":1,"tint":"#ffffff","alphaThreshold":0.75},"lockRotation":false,"rotation":0,"alpha":1,"disposition":-1,"displayBars":0,"bar1":{"attribute":"hp"},"bar2":{"attribute":"mp"},"light":{"negative":false,"priority":0,"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}},"sight":{"enable