{"_id":"ROv3bW5rOtIYcrU6","name":"Spirit Domain: Mirrored Soul","type":"ability","system":{"source":"class","classId":"","className":"Geomancer","featureType":"aspect","requirement":"Aspect, 10th Level Geomancer Required","cost":"Spirit Qi 1 - 4","metadata":"Cost: Spirit Qi 1 - 4\nDuration: 10 seconds (1 round)\nType: Curse","resourceData":{"baseRhythm":{"uplifting":0,"calming":0,"enchanting":0},"extraRhythm":{"uplifting":0,"calming":0,"enchanting":0},"rhythmCost":{"uplifting":0,"calming":0,"enchanting":0},"qiType":"spirit","qiMin":1,"qiMax":4,"hpCost":"","cardCount":1,"suggestedCardColor":"","edgeAccumulation":0,"edgeCost":0},"defenseModifier":0,"sourceUrl":"https://sw25.wikidot.com/aspect:spirit-domain-mirrored-soul","description":"This ability merges the souls of the target and the Geomancer, recognizing them as partially identical entities.\n\nFor the duration of this Aspect, whenever the Geomancer takes physical or magical damage from others, the target takes fixed damage equal to the greater of (HP reduced) or (Spirit Qi consumed x 2) points.","mpCost":0,"power":0,"powerTable":{},"critical":0,"criticalModifier":0,"hasPowerTable":false,"specialDamageBands":[],"school":"Geomancer","level":10},"img":"icons/svg/item-bag.svg","effects":[],"sort":0}
