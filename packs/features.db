{"_id":"pbFaB056TyWzPmXj","name":"⏩Foresight II","type":"ability","system":{"source":"class","classId":"","className":"Tactician","featureType":"maneuver","requirement":"Maneuver, Level 5 Tactician Required","cost":"5 Edge","metadata":"Conditions: [ Maneuver: Foresight I ]\nPrerequisite: None (used with Minor Action)\nEdge Cost: 5 Edge","resourceData":{"baseRhythm":{"uplifting":0,"calming":0,"enchanting":0},"extraRhythm":{"uplifting":0,"calming":0,"enchanting":0},"rhythmCost":{"uplifting":0,"calming":0,"enchanting":0},"qiType":"","qiMin":0,"qiMax":0,"hpCost":"","cardCount":1,"suggestedCardColor":"","edgeAccumulation":0,"edgeCost":5},"defenseModifier":0,"sourceUrl":"https://sw25.wikidot.com/maneuver:foresight-ii","description":"The eTactician predicts attacks in greater depth.\n\nFor 10 seconds (1 round), the Tactician gets a +5 bonus to their own Evasion checks.","mpCost":0,"power":0,"powerTable":{},"critical":0,"criticalModifier":0,"hasPowerTable":false,"specialDamageBands":[],"school":"Tactician","level":5},"img":"icons/svg/item-bag.svg","effects":[],"sort":0}
